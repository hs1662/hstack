{
  "hstack-guard": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/prompt-router.mjs",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(update_steps|ask_question|todo_write|task_create|task_update|update_plan)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-tool-use.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(mcp_hstack_.*|invoke_subagent|run_command|edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content|mcp_agy-fast_fast_apply_edits|mcp_agy-fast_apply_edits)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-tool-gate.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/post-invocation.mjs",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/stop.mjs",
        "timeout": 5
      }
    ]
  }
}
